rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'javeriamaqsood829@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Connectivity Test
    match /test/{testId} {
      allow read: if true;
    }

    // Site Settings
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero Section
    match /hero/{heroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // About Section
    match /about/{aboutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Process
    match /process/{processId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Skills
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experience
    match /experience/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Education & Certifications
    match /education/{educationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certifications/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects / Case Studies
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Results / Metrics
    match /results/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Navigation & SEO & Media
    match /navigation/{navId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo/{seoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inbound Messages: Public can create, only admin can read, update, delete
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 150 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 0 &&
                       request.resource.data.email.size() <= 200 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
